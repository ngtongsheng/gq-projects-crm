{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "plain",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install *)",
      "Bash(pnpm dev)",
      "Bash(pnpm free-port)",
      "Bash(pnpm build)",
      "Bash(pnpm check)",
      "Bash(pnpm check *)",
      "Bash(pnpm format)",
      "Bash(pnpm format *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm guard:migrations *)",
      "Bash(pnpm copy-env)",
      "Bash(pnpm db:test-copy)",
      "Bash(pnpm reset:sign-ins)",
      "Bash(pnpm connect:test-copy*)",
      "Bash(pnpm dlx shadcn@latest add *)",
      "Bash(git *)",
      "Bash(git push -u origin HEAD)",
      "Bash(git push origin HEAD:*)",
      "Bash(gh pr merge *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh run *)",
      "Bash(gh repo view *)",
      "Bash(pnpm exec supabase migration list*)",
      "Bash(pnpm exec supabase migration new *)",
      "Bash(pnpm exec supabase projects list*)",
      "Bash(pnpm exec supabase --version)"
    ],
    "deny": [
      "Bash(supabase db push*)",
      "Bash(pnpm exec supabase db push*)",
      "Bash(pnpm supabase db push*)",
      "Bash(npx supabase db push*)",
      "Bash(pnpm dlx supabase db push*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push origin main*)",
      "Bash(git push * origin main*)",
      "Bash(git push *:main*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh pr merge --admin*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent/session-sync.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent/session-sync.mjs\" --throttle 15m",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
