# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: only the dev Supabase config is committed (public by design, see loop D3)
.env*
!.env.development

# claude: per-change worktrees and personal settings
/.claude/worktrees/
/.claude/settings.local.json
/.claude/help-report.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
