{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["{env:HOME}/work/AGENTS.md"],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.13.0",
        "--autoConnect",
        "--no-usage-statistics"
      ]
    }
  },
  "permission": {
    "chrome-devtools_*": "allow"
  }
}
